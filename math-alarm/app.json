{
  "expo": {
    "name": "Wake up dongdong",
    "slug": "wake-up-dongdong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "mathalarm",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.donghyeon.mathalarm",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Wake up dongdong",
        "CFBundleLocalizations": [
          "ko",
          "en"
        ],
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "설정한 시간에 알람을 울리고 수학 문제로 해제하기 위해 알림 권한이 필요합니다."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "com.donghyeon.mathalarm",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f1419",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#3dd6c6",
          "defaultChannel": "alarms",
          "sounds": [
            "./assets/alarm.wav"
          ],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f1419",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "db852686-8856-498d-aeee-631e5e7f796f"
      }
    },
    "owner": "hyeon623"
  }
}
